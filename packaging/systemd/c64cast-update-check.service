[Unit]
Description=Check for a newer c64cast release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Must be the user c64cast.service runs as: this writes under that account's
# data root, which is where the console and the MOTD line read it. A mismatch
# fails silently.
User=c64cast
# `env` resolves on systemd's default PATH only: a `uv tool` install into
# ~/.local/bin needs a /usr/local/bin symlink, or an absolute path here.
ExecStart=/usr/bin/env c64cast --check-for-updates --write-state
# 4 = PyPI unreachable, which is not a service failure; the next run retries.
SuccessExitStatus=0 4
