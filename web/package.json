{
  "name": "c64cast-web",
  "private": true,
  "type": "module",
  "description": "Source for the c64cast web console. The built output is committed under c64cast/web/dist, so running c64cast never needs Node.",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.1.16",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
