{
  "name": "c64cast-web",
  "private": true,
  "type": "module",
  "description": "Source for the c64cast web console. The built output is committed under c64cast/web/dist, so running c64cast never needs Node.",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^26.2.0",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
